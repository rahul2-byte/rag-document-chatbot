# LLM provider: anthropic | openai | openrouter
LLM_PROVIDER=openrouter
# Model id for the chosen provider
LLM_MODEL=anthropic/claude-haiku-5.5
# Reasoning step for OpenRouter models: off (faster first token) or on; applies only when LLM_PROVIDER=openrouter
LLM_REASONING=off
# OpenRouter API key (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# Alternative: Anthropic (set LLM_PROVIDER=anthropic and LLM_MODEL to an Anthropic model id)
# ANTHROPIC_API_KEY=
# Alternative: OpenAI (set LLM_PROVIDER=openai and LLM_MODEL to an OpenAI model id)
# OPENAI_API_KEY=
